# Copy this file to .env and fill in what you have. Everything here is optional.

# --- Supabase (without these the app runs in local/demo mode using localStorage) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Site identity and footer links (empty = that link is simply not shown) ---
VITE_SITE_NAME=PortfolioHub
VITE_GITHUB_URL=
VITE_TWITTER_URL=
VITE_LINKEDIN_URL=
VITE_DOCS_URL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_CHANGELOG_URL=
