# Copy this file to .env (never commit .env) and fill in what you have. Everything is optional.

# --- Supabase. Without these the app runs in local/demo mode using localStorage. ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Site name and footer links. An empty value means that link is simply not shown. ---
VITE_SITE_NAME=PortfolioHub
VITE_GITHUB_URL=
VITE_TWITTER_URL=
VITE_LINKEDIN_URL=
VITE_DOCS_URL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_CHANGELOG_URL=

# --- DEMO mode only (no Supabase): this email becomes the admin. Ignored when Supabase is on. ---
VITE_DEMO_ADMIN_EMAIL=admin@demo.local
